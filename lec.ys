# 读取cell定义（使用-lib参数将其标记为库单元，防止flatten时展开）
# 关键：使用-lib而非-icells，让LEC工具理解GTP_LUT6D的行为模型
read_verilog -icells techlibs/yoyo/cells_sim.v
read_verilog -lib -nooverwrite techlibs/yoyo/cells_lib.v
# 读取映射后的设计
read_verilog mapped_tc1.v
hierarchy -check -auto-top
flatten
design -stash after_map

# 读取映射前的设计
# read_verilog original.v
# read_aiger ./tests/aig/i2c.aig
# 注意：test.ys 使用 input.blif（I0/O0 端口命名），
# 因此这里也用同一个源文件，避免端口名不匹配导致 equiv_make 失败。
read_blif tests/tc_public/tc_public_1/input.blif
hierarchy -check -auto-top
flatten
design -stash before_map

# 构建等价性验证网表
design -copy-from before_map -as gold A:top
design -copy-from after_map -as gate A:top
read_verilog -lib -nooverwrite techlibs/yoyo/cells_lib.v

equiv_make -inames gold gate equiv    
equiv_simple -nogroup -undef    
equiv_induct equiv
equiv_status equiv
